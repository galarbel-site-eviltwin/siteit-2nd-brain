# ===== Supabase (פרויקט eybdaafijertxizdwank, פרנקפורט) =====
NEXT_PUBLIC_SUPABASE_URL=https://eybdaafijertxizdwank.supabase.co

# Project Settings > API Keys > "Publishable key" (מתחיל ב-sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API Keys > "Secret keys" > Reveal (מתחיל ב-sb_secret_). סודי!
SUPABASE_SECRET_KEY=

# כפתור Connect בראש הדשבורד > Transaction pooler (פורט 6543)
# להחליף את [YOUR-PASSWORD] בסיסמת המסד, בלי הסוגריים המרובעים
DATABASE_URL=

# כפתור Connect > Session pooler (פורט 5432). אותה סיסמה. למיגרציות בלבד
DIRECT_DATABASE_URL=

# ===== Google OAuth (בהמשך, שלב 0) =====
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
